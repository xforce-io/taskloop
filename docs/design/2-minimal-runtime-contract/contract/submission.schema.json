{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "state_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "visit": {
      "type": "integer",
      "minimum": 1
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slot",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_version",
    "execution_id",
    "task_id",
    "run_id",
    "state_id",
    "visit",
    "contract_digest",
    "run_epoch",
    "artifacts"
  ],
  "additionalProperties": false
}
