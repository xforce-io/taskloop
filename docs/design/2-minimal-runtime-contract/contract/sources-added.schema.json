{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 20
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "urls",
    "reason"
  ],
  "additionalProperties": false
}
