{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "support": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "counter": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "text",
          "support",
          "counter",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": [
        "ready",
        "need_more",
        "need_input"
      ]
    }
  },
  "required": [
    "judgments",
    "gaps",
    "decision"
  ],
  "additionalProperties": false
}
