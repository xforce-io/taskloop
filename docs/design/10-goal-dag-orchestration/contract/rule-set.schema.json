{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskloop:rule-set:v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "maxLength": 16
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence_required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "instruction",
          "pass_condition",
          "evidence_required"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    }
  },
  "required": [
    "protocol_version",
    "id",
    "version",
    "rules"
  ],
  "additionalProperties": false
}
