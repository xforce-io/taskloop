{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskloop:check-requirement:v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "phase": {
      "enum": [
        "plan",
        "node_checkpoint",
        "goal_final"
      ]
    },
    "checker_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "rules_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "before_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "maxItems": 256,
      "uniqueItems": true,
      "minItems": 1
    },
    "required": {
      "const": true
    }
  },
  "required": [
    "id",
    "phase",
    "checker_ref",
    "rules_digest",
    "target_outputs",
    "required"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "target_outputs": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "target_outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "node_checkpoint"
          }
        }
      },
      "then": {
        "required": [
          "before_outputs"
        ]
      },
      "else": {
        "not": {
          "required": [
            "before_outputs"
          ]
        }
      }
    }
  ]
}
