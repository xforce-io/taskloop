{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskloop:capability-package:v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "maxLength": 16
    },
    "schemas": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minProperties": 0,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "rule_sets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minProperties": 0,
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "$ref": "taskloop:dag-entry:v1"
      }
    },
    "entry_budgets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._@-]{1,128}$"
          },
          "max_run_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "max_check_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "max_tool_calls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "submission_reserve": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "finalize_before_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "max_model_iterations": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "max_candidate_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "policy_id",
          "max_run_ms",
          "max_check_ms",
          "max_tool_calls",
          "submission_reserve",
          "finalize_before_ms",
          "max_model_iterations",
          "max_candidate_bytes"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "$ref": "taskloop:node-contract:v1"
      }
    },
    "checkers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minProperties": 0,
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "entry_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "rules_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "result_slot": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "fresh_context": {
            "const": true
          },
          "goal_input_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "entry_ref",
          "rules_ref",
          "result_slot",
          "fresh_context",
          "goal_input_fields"
        ],
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "taskloop:orchestration-profile:v1"
      }
    }
  },
  "required": [
    "protocol_version",
    "id",
    "version",
    "schemas",
    "skills",
    "rule_sets",
    "entries",
    "entry_budgets",
    "capabilities",
    "checkers",
    "profiles"
  ],
  "additionalProperties": false
}
