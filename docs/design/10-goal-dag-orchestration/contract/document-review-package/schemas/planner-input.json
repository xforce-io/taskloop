{
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "goal_spec_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planning_mode": {
      "const": "autonomous"
    },
    "capability_catalog": {
      "type": "array",
      "items": {
        "$ref": "taskloop:node-contract:v1"
      },
      "maxItems": 256
    },
    "profile": {
      "$ref": "taskloop:orchestration-profile:v1"
    },
    "planning_feedback": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "previous_candidate_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object"
          }
        },
        "check_results": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "attempt",
        "previous_candidate_sha",
        "errors",
        "check_results"
      ],
      "additionalProperties": false
    },
    "effective_limits": {
      "type": "object",
      "properties": {
        "max_wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_active_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_transitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_total_candidate_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_concurrent_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "max_wall_ms",
        "max_active_ms",
        "max_runs",
        "max_transitions",
        "max_tool_calls",
        "max_total_candidate_bytes",
        "max_concurrent_runs"
      ],
      "additionalProperties": false
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "schema_digest"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    }
  },
  "required": [
    "goal",
    "inputs",
    "goal_spec_digest",
    "profile_digest",
    "planning_mode",
    "capability_catalog",
    "profile",
    "planning_feedback",
    "effective_limits",
    "imports"
  ],
  "additionalProperties": false
}
