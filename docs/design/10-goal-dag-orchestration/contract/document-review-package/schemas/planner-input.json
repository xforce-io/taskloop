{
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "goal_spec_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planning_mode": {
      "const": "autonomous"
    },
    "capability_catalog": {
      "type": "array",
      "items": {
        "$ref": "taskloop:node-contract:v1"
      },
      "maxItems": 256
    },
    "profile": {
      "$ref": "taskloop:orchestration-profile:v1"
    },
    "planning_feedback": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "previous_candidate_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object"
          }
        },
        "check_results": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "attempt",
        "previous_candidate_sha",
        "errors",
        "check_results"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "goal",
    "inputs",
    "goal_spec_digest",
    "profile_digest",
    "planning_mode",
    "capability_catalog",
    "profile",
    "planning_feedback"
  ],
  "additionalProperties": false
}
