{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskloop:goal-request:v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "grant_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "spec": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "inputs": {
          "type": "object"
        },
        "profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "planning": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "autonomous",
                "workflow"
              ]
            },
            "max_revisions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "default": 2
            },
            "max_planning_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "template_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "mode",
            "max_planning_ms"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "workflow"
                  }
                }
              },
              "then": {
                "required": [
                  "template_ref"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "template_ref"
                  ]
                }
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_wall_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_active_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_runs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_transitions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_total_candidate_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_concurrent_runs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "max_wall_ms",
            "max_active_ms",
            "max_runs",
            "max_transitions",
            "max_tool_calls",
            "max_total_candidate_bytes",
            "max_concurrent_runs"
          ],
          "additionalProperties": false
        },
        "parent_goal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "schema_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "artifact_id",
              "sha256",
              "schema_digest"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "goal",
        "inputs",
        "profile_ref",
        "planning",
        "limits"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "request_key",
    "grant_ref",
    "spec"
  ],
  "additionalProperties": false
}
