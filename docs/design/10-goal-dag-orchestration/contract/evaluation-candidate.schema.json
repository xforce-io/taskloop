{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskloop:evaluation-candidate:v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "verdict",
          "message",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "code",
          "subject",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    }
  },
  "required": [
    "protocol_version",
    "verdict",
    "results",
    "evidence_refs",
    "violations"
  ],
  "additionalProperties": false
}
