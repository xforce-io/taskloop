{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskloop:check-input:v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "goal_spec_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "rules_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "enum": [
        "plan",
        "node_checkpoint",
        "goal_final",
        "node_evaluation"
      ]
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "issued_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "proposal"
            },
            "proposal_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "proposal": {
              "$ref": "taskloop:plan-proposal:v1"
            }
          },
          "required": [
            "kind",
            "proposal_digest",
            "proposal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "artifacts"
            },
            "plan_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "targets": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "minProperties": 1,
              "maxProperties": 256,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "schema_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "value": {}
                },
                "required": [
                  "artifact_id",
                  "sha256",
                  "schema_digest",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "plan_digest",
            "targets"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rules": {
      "$ref": "taskloop:rule-set:v1"
    },
    "goal_inputs": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 512,
      "uniqueItems": true
    }
  },
  "required": [
    "protocol_version",
    "goal_id",
    "goal",
    "goal_spec_digest",
    "check_id",
    "rules_digest",
    "phase",
    "epoch",
    "nonce",
    "issued_revision",
    "subject",
    "rules",
    "goal_inputs",
    "evidence_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "proposal"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "artifacts"
              }
            }
          }
        }
      }
    }
  ]
}
