{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskloop:dag-entry:v1",
  "type": "object",
  "properties": {
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    },
    "executor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "input_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "requires": {
      "const": []
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "required": {
            "const": true
          }
        },
        "required": [
          "schema",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "object",
      "properties": {
        "slot_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "slot_prefix",
        "path_prefix",
        "max_files",
        "max_bytes"
      ],
      "additionalProperties": false
    },
    "gate": {
      "const": "_tl.schema@1"
    },
    "outcomes": {
      "const": [
        "completed"
      ]
    }
  },
  "required": [
    "instruction",
    "executor",
    "skills",
    "tools",
    "input_schema",
    "requires",
    "outputs",
    "gate",
    "outcomes"
  ],
  "additionalProperties": false
}
