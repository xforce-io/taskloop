{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "executor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "input_schema": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "schema": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "const": true
                }
              },
              "required": [
                "schema",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "gate": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "attachments": {
            "type": "object",
            "properties": {
              "slot_prefix": {
                "type": "string",
                "minLength": 1
              },
              "path_prefix": {
                "type": "string",
                "minLength": 1
              },
              "max_files": {
                "type": "integer",
                "minimum": 1
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "slot_prefix",
              "path_prefix",
              "max_files",
              "max_bytes"
            ],
            "additionalProperties": false
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "slot": {
                  "type": "string",
                  "minLength": 1
                },
                "selection": {
                  "enum": [
                    "latest",
                    "all"
                  ]
                }
              },
              "required": [
                "state",
                "slot",
                "selection"
              ],
              "additionalProperties": false
            }
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "executor",
          "skills",
          "input_schema",
          "outputs",
          "gate",
          "outcomes",
          "instruction",
          "tools"
        ],
        "additionalProperties": false
      }
    },
    "flow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_transitions": {
              "type": "integer",
              "minimum": 1
            },
            "max_visits_per_state": {
              "type": "integer",
              "minimum": 1
            },
            "max_runs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_transitions",
            "max_visits_per_state",
            "max_runs"
          ],
          "additionalProperties": false
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "work"
                  },
                  "entry": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "accepted": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_.-]*$"
                    }
                  },
                  "rejected": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "failed": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  }
                },
                "required": [
                  "kind",
                  "entry",
                  "accepted",
                  "rejected",
                  "failed"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "wait"
                  },
                  "signals": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "schema": {
                          "type": "string",
                          "minLength": 1
                        },
                        "target": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_.-]*$"
                        }
                      },
                      "required": [
                        "schema",
                        "target"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "timeout_target": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  }
                },
                "required": [
                  "kind",
                  "signals",
                  "timeout_seconds",
                  "timeout_target"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "terminal"
                  },
                  "status": {
                    "enum": [
                      "completed",
                      "failed"
                    ]
                  },
                  "outcome": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "requires": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "minLength": 1
                        },
                        "slot": {
                          "type": "string",
                          "minLength": 1
                        },
                        "selection": {
                          "enum": [
                            "latest",
                            "all"
                          ]
                        }
                      },
                      "required": [
                        "state",
                        "slot",
                        "selection"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "kind",
                  "status",
                  "outcome",
                  "requires"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "input_schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "initial",
        "limits",
        "states",
        "input_schema"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "entries",
    "flow"
  ],
  "additionalProperties": false
}
