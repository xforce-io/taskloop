{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "subject",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "outcome",
    "evidence_refs",
    "violations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "violations": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "outcome": {
            "type": "null"
          },
          "violations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
